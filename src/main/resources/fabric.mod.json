{
	"schemaVersion": 1,
	"id": "flextools",
	"version": "${version}",
	"name": "Flex Tools",
	"description": "javaの練習(技術習得) ＋ 自分のほしい機能を詰め込むこむ為に作ったMODです。",
	"authors": [
		"rado1049"
	],
	"contact": {
		"sources": "https://github.com/radolemon/FlexTools.git",
		"issues": "https://github.com/radolemon/FlexTools/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/flextools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.flextools.FlexTools"
		],
		"client": [
			"com.flextools.FlexToolsClient"
		]
	},
	"mixins": [
		"flextools.mixins.json",
		{
			"config": "flextools.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.12",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}